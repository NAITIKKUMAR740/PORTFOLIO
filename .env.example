# Application
NODE_ENV=development
PORT=5000
APP_NAME=DevPortfolio
CLIENT_ORIGIN=http://localhost:5000

# MongoDB (Local MongoDB default)
MONGO_URI=mongodb://127.0.0.1:27017/portfolio_db

# Admin Authentication (Change before deploying to production!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# Optional: supply a bcrypt hash instead of plaintext ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=
ADMIN_API_KEY=change-this-admin-api-key-in-production
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Email Integration (Nodemailer SMTP)
# Leave SMTP_HOST/SMTP_USER/SMTP_PASS blank in development to use Ethereal preview fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Portfolio Contact <no-reply@example.com>"
CONTACT_RECEIVER_EMAIL=owner@example.com
