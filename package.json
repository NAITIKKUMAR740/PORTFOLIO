{
  "name": "fullstack-developer-portfolio",
  "version": "1.0.0",
  "description": "Full-stack personal portfolio website built with HTML, CSS, JavaScript, Node.js, Express.js, and MongoDB using MVC/layered architecture.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seedData.js",
    "seed:reset": "node src/seed/seedData.js --reset",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "portfolio",
    "express",
    "mongodb",
    "mongoose",
    "mvc",
    "full-stack"
  ],
  "author": "Full-Stack Developer",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
